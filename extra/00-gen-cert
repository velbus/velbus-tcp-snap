#!/bin/sh

# Migrate certificates created by older versions of the snap.
# Previous releases stored certificates in $SNAP_COMMON, which is shared
# across all parallel instances. They are now stored in $SNAP_DATA so each
# instance has its own certificate. During an upgrade (settings.json exists),
# copy any existing certificate from $SNAP_COMMON to the new $SNAP_DATA
# location. On a fresh install, settings.json does not exist yet, so this
# is skipped and a new certificate is generated for this instance.
if [ -f "$SNAP_DATA/settings.json" ] && [ ! -f "$SNAP_DATA/certificate.pem" ] && [ -f "$SNAP_COMMON/certificate.pem" ] && [ -f "$SNAP_COMMON/privkey.pem" ]; then
    cp "$SNAP_COMMON/certificate.pem" "$SNAP_DATA/certificate.pem"
    cp "$SNAP_COMMON/privkey.pem" "$SNAP_DATA/privkey.pem"
    snapctl set tcp.cert="$SNAP_DATA/certificate.pem"
    snapctl set tcp.pk="$SNAP_DATA/privkey.pem"
fi

# Check if we have a certificate
if [ ! -f "$SNAP_DATA/certificate.pem" ]; then

    # Generate 2048 bit RSA private key (no passphrase)
    openssl genrsa -out "$SNAP_DATA/privkey.pem" 2048

    # Generate certificate signing request (CSR)
    openssl req -new -key "$SNAP_DATA/privkey.pem" -out "$SNAP_DATA/signreq.csr" -subj "/C=BE/ST=Oost-Vlaanderen/L=Gavere/O=Velleman/OU=Velbus/CN=www.velbus.eu/emailAddress=sslkey@velbus.eu"

    # Sign the certificate signing request
    openssl x509 -req -days 365 -in "$SNAP_DATA/signreq.csr" -signkey "$SNAP_DATA/privkey.pem" -out "$SNAP_DATA/certificate.pem"

    # Set config
    snapctl set tcp.ssl=true
    snapctl set tcp.cert="$SNAP_DATA/certificate.pem"
    snapctl set tcp.pk="$SNAP_DATA/privkey.pem"
    snapctl set tcp.auth=false
    snapctl set tcp.authkey="$(cat /proc/sys/kernel/random/uuid)"
fi
